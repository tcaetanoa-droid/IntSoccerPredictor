# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv
.venv.nosync/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Simulation run outputs (regenerable)
output/*
!output/.gitkeep

# Downloaded TSVs (regenerable via `intsoccer fetch`)
data/raw/*
!data/raw/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# Brainstorm visual companion sessions (mockups, not source)
.superpowers/

# Impeccable: session state, snapshots and caches (surface briefs and config.json stay committed)
.impeccable/live/
.impeccable/critique/
.impeccable/review/
.impeccable/mocks/
.impeccable/build/
.impeccable/hook.cache.json
.impeccable/config.local.json
.impeccable/questions/
